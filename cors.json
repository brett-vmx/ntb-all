{
  "rules": [
    {
      "allowed": {
        "origins": ["https://new-tibetan-bible.app", "https://www.new-tibetan-bible.app", "http://localhost:4418", "http://127.0.0.1:4418"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
